{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "slogslogslog",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's Slog floor",
        "description": "Create today's arena post for Slog. Idempotent.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/scheduler/roll-floor"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-floor": {
        "endpoint": "/internal/scheduler/daily-floor",
        "cron": "0 12 * * *"
      },
      "auto-advance": {
        "endpoint": "/internal/scheduler/auto-advance",
        "cron": "*/10 * * * *"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-install",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "dev": {
    "subreddit": "slogslogslog_dev"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "slogslogslog_dev"
  }
}
